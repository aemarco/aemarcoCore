<?xml version="1.0" encoding="utf-8"?>
<Project>
	<!-- Test folder, this runs at the beginning -->

	<PropertyGroup>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- the collector ships its targets in build/ only, so a transitive reference (via aemarco.TestBasics) never deploys it -->
	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.2" />
	</ItemGroup>

</Project>