<?xml version="1.0" encoding="utf-8"?>
<Project>
	<!-- Test folder: everything from the root Directory.Build.props, plus the test setup below -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- nuget references, every test project gets the full test stack directly -->
	<!-- (coverlet.collector ships its targets in build/ only, so a transitive reference would never deploy it) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="GitHubActionsTestLogger" />

		<!-- brings NUnit and Shouldly along, plus Dump() for test output and fixture helpers -->
		<PackageReference Include="aemarcoToolboxTesting" />
		<PackageReference Include="NUnit.Analyzers" />
		<PackageReference Include="NUnit3TestAdapter" />

		<PackageReference Include="NSubstitute" />

		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<!-- global usings for the test stack above and the common System namespaces; project-specific ones stay in the project's GlobalUsings.cs -->
	<ItemGroup>
		<Using Include="aemarcoCommons.ToolboxTesting" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="NSubstitute" />
		<Using Include="NUnit.Framework" />
		<Using Include="Shouldly" />
		<Using Include="System" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Linq" />
		<Using Include="System.Threading" />
		<Using Include="System.Threading.Tasks" />
	</ItemGroup>

</Project>
